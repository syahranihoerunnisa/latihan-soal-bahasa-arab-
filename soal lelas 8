<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Latihan PTS Bahasa Arab Kelas VIII</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Amiri:wght@700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{
background:linear-gradient(135deg,#0EA5E9,#10B981);
min-height:100vh;
padding:20px;
}

.container{
max-width:900px;
margin:auto;
}

.header{
background:white;
border-radius:20px;
padding:25px;
text-align:center;
margin-bottom:20px;
box-shadow:0 10px 30px rgba(0,0,0,.15);
}

.header h1{
color:#0F172A;
}

.header p{
color:#64748B;
margin-top:8px;
}

.topbar{
display:flex;
justify-content:space-between;
color:white;
font-weight:bold;
margin-bottom:10px;
}

.progress{
height:12px;
background:rgba(255,255,255,.3);
border-radius:20px;
overflow:hidden;
margin-bottom:20px;
}

.bar{
height:100%;
width:0%;
background:white;
transition:.3s;
}

.card{
background:white;
padding:30px;
border-radius:20px;
box-shadow:0 10px 30px rgba(0,0,0,.15);
}

#questionNumber{
color:#2563EB;
font-weight:bold;
margin-bottom:10px;
}

#question{
font-size:24px;
margin-bottom:25px;
line-height:1.5;
}

.arab{
font-family:Amiri,serif;
font-size:30px;
direction:rtl;
}

.option{
border:2px solid #E5E7EB;
padding:15px;
border-radius:12px;
margin-bottom:12px;
cursor:pointer;
transition:.2s;
}

.option:hover{
background:#ECFEFF;
border-color:#0EA5E9;
}

.selected{
background:#DCFCE7;
border-color:#10B981;
}

button{
width:100%;
padding:16px;
background:#2563EB;
color:white;
border:none;
border-radius:12px;
font-size:18px;
cursor:pointer;
margin-top:15px;
}

button:hover{
background:#1D4ED8;
}

.hidden{
display:none;
}

.result{
background:white;
padding:30px;
border-radius:20px;
box-shadow:0 10px 30px rgba(0,0,0,.15);
}

.score{
font-size:55px;
color:#2563EB;
font-weight:bold;
margin:20px 0;
text-align:center;
}

.review{
margin-top:25px;
}

.review-item{
padding:15px;
border-bottom:1px solid #eee;
}

.correct{
color:green;
font-weight:bold;
}

.wrong{
color:red;
font-weight:bold;
}

@media(max-width:600px){

#question{
font-size:20px;
}

.arab{
font-size:25px;
}

}

</style>
</head>
<body>

<div class="container">

<div class="header">
<h1>📚 Latihan PTS Bahasa Arab</h1>
<p>Kelas VIII Semester Ganjil • 35 Soal</p>
</div>

<div class="topbar">
<div id="timer">60:00</div>
<div id="progressText">1 / 35</div>
</div>

<div class="progress">
<div class="bar" id="bar"></div>
</div>

<div class="card" id="quizCard">

<div id="questionNumber"></div>

<div id="question"></div>

<div id="options"></div>

<button id="nextBtn">Selanjutnya ➜</button>

</div>

<div id="result" class="hidden"></div>

</div>

<script>

const questions=[

{q:"Tokoh utama dalam bacaan adalah...",o:["زَيْنَب","يُوسُف","أَبِي","أُمِّي"],a:1},
{q:"Yusuf adalah siswa kelas...",o:["VII","VIII","IX","VI"],a:1},
{q:"Yusuf pergi ke perpustakaan pada hari...",o:["Jumat","Sabtu","Senin","Ahad"],a:2},
{q:"Tujuan Yusuf ke perpustakaan adalah...",o:["Bermain","Membaca buku","Memotret","Memasak"],a:1},
{q:"Yusuf bermain bola basket pada hari...",o:["Jumat","Senin","Selasa","Ahad"],a:0},
{q:"Hobi Zainab adalah...",o:["السِّبَاحَة","الرَّسْم","الطَّبْخ","التَّصْوِير"],a:1},
{q:"Ayah Yusuf suka...",o:["Membaca","Memotret","Bepergian","Bermain bola"],a:2},
{q:"Ibu Yusuf memotret ketika pergi ke...",o:["Masjid","Pantai","Sekolah","Pasar"],a:1},
{q:"Kata السفر berarti...",o:["Membaca","Memasak","Bepergian","Menggambar"],a:2},
{q:"Keluarga Yusuf suka...",o:["Belajar sendiri","Bermain setiap hari","Menghabiskan waktu bersama","Tidur bersama"],a:2},

{q:"Rafi membawa kamera saat piknik. Hobinya adalah...",o:["الطَّبْخ","الرَّسْم","التَّصْوِير","السَّفَر"],a:2},
{q:"Siti membuat kue bersama ibunya. Kata yang tepat adalah...",o:["الطَّبْخ","السِّبَاحَة","الرَّسْم","التَّصْوِير"],a:0},
{q:"Danu menggambar pemandangan. Hobinya adalah...",o:["الرَّسْم","السَّفَر","الطَّبْخ","الْقِرَاءَة"],a:0},
{q:"Kata المدرسة termasuk...",o:["Fi'il","Huruf","Isim","Bilangan"],a:2},
{q:"Kata الحديقة termasuk...",o:["Isim","Fi'il","Huruf","Dhamir"],a:0},
{q:"Yang termasuk Fi'il adalah...",o:["قَلَمٌ","يَكْتُبُ","بَيْتٌ","مَدْرَسَةٌ"],a:1},
{q:"Yang termasuk Fi'il adalah...",o:["يَلْعَبُ","بَيْتٌ","طَالِبٌ","مَدْرَسَةٌ"],a:0},
{q:"Yang termasuk Huruf adalah...",o:["عَلَى","جَلَسَ","مُعَلِّمٌ","طَبِيبٌ"],a:0},
{q:"Yang termasuk Huruf adalah...",o:["مِنْ","يَذْهَبُ","قَلَمٌ","بَيْتٌ"],a:0},
{q:"Dalam kalimat الطالب في الفصل, kata في termasuk...",o:["Isim","Fi'il","Huruf","Dhamir"],a:2},

{q:"Arti كرة السلة adalah...",o:["Sepak bola","Bola basket","Bola voli","Bulu tangkis"],a:1},
{q:"Arti كرة القدم adalah...",o:["Bola basket","Bola voli","Sepak bola","Tenis"],a:2},
{q:"Arti كرة الطائرة adalah...",o:["Bola voli","Sepak bola","Bola basket","Bulu tangkis"],a:0},
{q:"Bahasa Arab dari 'pagi hari' adalah...",o:["ليلاً","مساءً","نهارًا","صباحًا"],a:3},
{q:"Bahasa Arab dari 'malam hari' adalah...",o:["نهارًا","صباحًا","ليلاً","مساءً"],a:2},

{q:"الساعة السابعة والربع berarti...",o:["07.15","07.30","07.45","08.15"],a:0},
{q:"Pukul 06.30 dalam bahasa Arab adalah...",o:["السادسة والربع","السادسة والنصف","السابعة إلا ربعًا","السابعة"],a:1},
{q:"Pukul 04.45 adalah...",o:["الرابعة والنصف","الرابعة والربع","الخامسة إلا ربعًا","الخامسة"],a:2},
{q:"الساعة التاسعة والنصف berarti...",o:["09.15","09.30","09.45","10.00"],a:1},
{q:"Pukul 11.45 dalam bahasa Arab adalah...",o:["الحادية عشرة والربع","الثانية عشرة إلا ربعًا","الحادية عشرة والنصف","الثانية عشرة"],a:1},

{q:"Muhammad pulang pada الساعة الثامنة مساءً. Berarti pukul...",o:["08.00 pagi","08.00 malam","09.00 malam","07.00 malam"],a:1},
{q:"Pilih harakat yang benar!",o:["هُوَ طَبِيبٌ","هُوَ طَبِيبَ","هُوَ طَبِيبِ","هُوُ طَبِيبٌ"],a:0},
{q:"Arti يذهب adalah...",o:["Duduk","Menulis","Pergi","Membaca"],a:2},
{q:"Arti قرأ adalah...",o:["Bermain","Membaca","Memasak","Tidur"],a:1},
{q:"Arti كتب adalah...",o:["Menulis","Pergi","Menggambar","Memotret"],a:0}

];

let current=0;
let score=0;
let answers=[];

const question=document.getElementById("question");
const options=document.getElementById("options");

function loadQuestion(){

const data=questions[current];

document.getElementById("questionNumber").innerHTML="Soal "+(current+1);

document.getElementById("progressText").innerHTML=(current+1)+" / "+questions.length;

document.getElementById("bar").style.width=((current+1)/questions.length*100)+"%";

question.innerHTML=data.q;

options.innerHTML="";

data.o.forEach((text,index)=>{

const div=document.createElement("div");

div.className="option";

if(/[\u0600-\u06FF]/.test(text)) div.classList.add("arab");

div.innerHTML=text;

div.onclick=()=>{

document.querySelectorAll(".option").forEach(x=>x.classList.remove("selected"));

div.classList.add("selected");

answers[current]=index;

};

options.appendChild(div);

});

}

loadQuestion();

document.getElementById("nextBtn").onclick=()=>{

if(answers[current]==undefined){

alert("Pilih jawaban dulu ya 😊");

return;

}

if(answers[current]==questions[current].a) score++;

current++;

if(current<questions.length){

loadQuestion();

}else{

finishQuiz();

}

};

function finishQuiz(){

document.getElementById("quizCard").classList.add("hidden");

let nilai=Math.round(score/questions.length*100);

let review="";

questions.forEach((q,i)=>{

review+=`

<div class="review-item">

<b>${i+1}. ${q.q}</b><br>

Jawabanmu:
<span class="${answers[i]==q.a?'correct':'wrong'}">${q.o[answers[i]]}</span><br>

Jawaban benar:
<span class="correct">${q.o[q.a]}</span>

</div>

`;

});

document.getElementById("result").classList.remove("hidden");

document.getElementById("result").innerHTML=`

<div class="result">

<h2 style="text-align:center;">🎉 Latihan Selesai!</h2>

<div class="score">${nilai}</div>

<p style="text-align:center;">Benar ${score} dari ${questions.length} soal.</p>

<div class="review">

<h3>Pembahasan</h3>

${review}

</div>

<button onclick="location.reload()">Ulangi Latihan</button>

</div>

`;

}

let time=3600;

const timer=document.getElementById("timer");

const countdown=setInterval(()=>{

let m=Math.floor(time/60);

let s=time%60;

timer.innerHTML=m+":"+(s<10?"0":"")+s;

time--;

if(time<0){

clearInterval(countdown);

finishQuiz();

}

},1000);

</script>

</body>
</html>
